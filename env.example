# Скопируйте этот файл в .env (cp env.example .env) и заполните. Имя образца без точки нарочно:
# файлы с точкой в начале нельзя загрузить на GitHub перетаскиванием. Пустое значение = «не задано».
# Пишите без кавычек и без комментариев в конце строки.
# ПОСЛЕ ЛЮБОЙ ПРАВКИ .env на сервере: docker compose up -d --force-recreate
# (docker compose restart файл .env заново НЕ читает).

# --- Telegram: только публикация в канал ---
TG_TOKEN=
# @username канала или числовой ID; боту нужны права публикации
TG_CHANNEL=

# --- MAX: приём материалов, согласование и управление ---
MAX_TOKEN=
MAX_CHANNEL=
MAX_APPROVERS=
MAX_EMPLOYEES=
MAX_ADMINS=
MAX_LOG_UPDATES=0

# --- Нейросеть ---
LLM_PROVIDER=openai
LLM_API_KEY=
# Адрес обязателен. Без него бот не запустится (раньше молча шёл в api.openai.com).
LLM_BASE_URL=https://api.aitunnel.ru/v1
# Модель задаёт именно переменная MODEL (LLM_MODEL бот не читает)
MODEL=gpt-4.1-mini
# Только для LLM_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=
LLM_VISION=1

# --- Видео (принимается из MAX) ---
# Лимит Telegram на файл от бота — 50 МБ, поэтому по умолчанию 49
MAX_VIDEO_MB=49
# Длиннее — отклоняется (секунды)
MAX_VIDEO_SEC=180

# --- Куда публиковать и где согласовывать ---
APPROVAL_PLATFORM=max
PUBLISH_TO_ALL=0

# --- Поведение ---
COMPANY=
STYLE=дружелюбный, деловой тон, без канцелярита
EMPLOYEE_NOTIFY=0
EMPLOYEE_CONFIRM=reaction
RATE_LIMIT_PER_HOUR=20
ALERT_THROTTLE_SEC=300
ACCESS_REQUESTS=1
REQUIRE_CAPTION=1
MIN_CAPTION_CHARS=8
LEARN_RULES=1

# --- Уведомления согласующим ---
# Рабочее время: сообщения приходят со звуком только тогда (дни: 1 = понедельник … 7 = воскресенье)
NOTIFY_HOURS=10-18
NOTIFY_DAYS=1-5
NOTIFY_TZ=Asia/Yekaterinburg
# Режим по умолчанию для новых согласующих; каждый меняет его кнопкой «🔔 Уведомления»:
# normal — всегда со звуком, silent — вне рабочих часов без звука, defer — вне рабочих часов придержать, muted — мут
NOTIFY_DEFAULT=silent

# --- Обновление кнопкой «🔄 Обновить» (только админ) ---
# Адрес репозитория на GitHub. Для приватного: https://ТОКЕН@github.com/ВЛАДЕЛЕЦ/РЕПОЗИТОРИЙ.git
# Пусто = бот работает из образа Docker, автообновления нет.
GITHUB_REPO=
GITHUB_BRANCH=main

# --- Напоминания и служебное ---
REMIND_AFTER_MIN=180
STARTUP_NOTIFY=1
# Необработанные черновики: дней с последней отправки на согласование
DRAFT_TTL_DAYS=7
# Служебное (обычно не трогать):
# MAX_POST_CHARS=3900
# REMIND_CHECK_SEC=300
# Как часто (сек) бот убирает старые фото и закрывает брошенные черновики:
# HOUSEKEEPING_SEC=21600
# Сколько секунд ждать при остановке, пока доделаются начатые публикации и посты:
# SHUTDOWN_DRAIN_SEC=30
# PROBATION_SEC=120
# UPDATE_TEST_CMD=python -m pytest -q -x
# CODE_DIR=/app/code
# APP_DIR=/app
# DATA_DIR=data
